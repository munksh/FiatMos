[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5

# Icon and Exec name the PACKAGE, never the app. What anyone sees is Name=.
Icon=harbour-fiatmos
Exec=/usr/bin/harbour-fiatmos

Name=fiat mos
Comment=Habit tracker where each habit sets its own detail

Name[sv]=fiat mos
Comment[sv]=Vanedagbok där varje vana väljer sin egen detaljnivå

# Sandboxing. Two permissions, each here for one reason.
#
# Documents lets Backup write your export where you can find it, and read one
# back on a new phone.
#
# Internet is for Look up, when you add a book: the ISBN goes to the lookup
# services the user has switched on (Open Library, Libris, the German and
# French national libraries and, only if allowed, Google Books) and the cover
# comes back. Nothing else in the app touches the network, and nothing does
# until that button is pressed.
#
# Sailjail permissions are static -- granted at launch, never requested on
# demand -- and cannot be limited to certain hosts. So which services may be
# contacted is enforced by the app itself: a per-service switch the user sets
# before anything is sent (LookupSettings.qml). A service that is off is never
# contacted, not even for its covers.
#
# Everything else is still no. No camera, no microphone, no contacts, no
# location, no calendar, no pictures.
#
# OrganizationName and ApplicationName also decide where the sandbox puts the
# app's data, so changing either one moves the database. Do not touch them
# after a release without a plan for the file.
[X-Sailjail]
OrganizationName=se.munkstolen
ApplicationName=harbour-fiatmos
Permissions=Documents;Internet
